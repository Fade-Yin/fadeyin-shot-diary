{
  "name": "fadeyin-shot-diary",
  "version": "0.7.30",
  "description": "片拉拉 - 镜头拆解与序列拉片分析",
  "main": "main.js",
  "author": "Fadeyin",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check ai-api.cjs",
    "build:win": "electron-builder --win portable",
    "build:win-installer": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg zip",
    "build:mac:x64": "electron-builder --mac dmg zip --x64",
    "build:mac:arm64": "electron-builder --mac dmg zip --arm64"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.62.1"
  },
  "build": {
    "appId": "com.fadeyin.shotdiary",
    "productName": "片拉拉",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ai-api.cjs",
      "report-stream.cjs",
      "assets/fadeyin-icon.png",
      "assets/fadeyin-icon.ico"
    ],
    "extraResources": [
      {
        "from": "ui",
        "to": "ui",
        "filter": [
          "*.html",
          "*.js",
          "*.css",
          "*.png"
        ]
      }
    ],
    "win": {
      "icon": "assets/fadeyin-icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "Pianlala-Windows-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "icon": "assets/fadeyin-icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "artifactName": "Pianlala-macOS-${arch}-${version}.${ext}"
    },
    "dmg": {
      "title": "片拉拉"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
